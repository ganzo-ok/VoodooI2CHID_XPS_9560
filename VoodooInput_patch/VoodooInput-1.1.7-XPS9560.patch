+// REV 10: when VoodooInput is stopped as part of a termination (e.g. its provider is a USB HID device that
+// DriverKit terminates at shutdown), IOKit is already terminating the simulator/actuator/trackpoint children and
+// will stop/detach them itself and later call IOHIDDevice::didTerminate on them. Stopping and detaching them by
+// hand here as well drops the last reference and frees them first -> use-after-free panic in didTerminate
+// (CR2=0x48). Only tear down children that are not already being terminated; always drop our own reference.
+static void stopChild(IOService *child, IOService *parent) {
+    if (!child->isInactive()) {
+        child->stop(parent);
+        child->detach(parent);
+    }
+}
