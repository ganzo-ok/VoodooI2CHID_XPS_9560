@@ -153,6 +154,28 @@ void TrackpointDevice::updateScrollwheel(short deltaAxis1, short deltaAxis2, sho
     dispatchScrollWheelEvent(deltaAxis1, deltaAxis2, deltaAxis3, timestamp);
 }
 
+// REV 12: IOHIDSystem attaches an IOHIDPointingEventDevice shim (an IOHIDDevice) to every legacy IOHIPointing such
+// as this one, and drops its own reference right away, so only the registry keeps the shim alive. When the whole
+// subtree is terminated at shutdown (touchscreen on USB, terminated by DriverKit) the shim can be freed on another
+// thread before IOKit calls IOHIDDevice::didTerminate on it -> panic in didTerminate+0x1e (_reserved == NULL,
+// CR2=0x48). Hold our own reference on our children from the start of termination until we are freed ourselves,
+// i.e. after IOKit is done with all of them.
 bool TrackpointDevice::willTerminate(IOService* provider, IOOptionBits options) {
+    if (!terminatingChildren) {
+        terminatingChildren = OSArray::withCapacity(1);
+        OSIterator *it = getChildIterator(gIOServicePlane);
+        if (terminatingChildren && it) {
+            while (OSObject *child = it->getNextObject())
+                terminatingChildren->setObject(child);
+        }
+        OSSafeReleaseNULL(it);
+        IOLog("VoodooInput REV 12: TrackpointDevice retained %u child(ren) for termination\n",
+              terminatingChildren ? terminatingChildren->getCount() : 0);
+    }
     return  super::willTerminate(provider, options);
 }
+
+void TrackpointDevice::free() {
+    OSSafeReleaseNULL(terminatingChildren);
+    super::free();
+}
